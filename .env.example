# Salin ke .env lalu isi. Jangan commit .env.

# Telegram (wajib untuk alert)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
DRY_RUN=false
# Bahasa alert Telegram: en (Inggris) atau id (Indonesia). Satu alert = satu bahasa.
# Kalau dikosongkan, kode memakai "en".
ALERT_LANG=en
TELEGRAM_MIN_INTERVAL_SEC=3
TELEGRAM_MAX_PER_HOUR=40
TELEGRAM_MAX_PER_DAY=400

# Antrean alert: kirim sesuai skor, jangan buang saat kuota penuh
ALERT_QUEUE_TTL_SEC=900
ALERT_QUEUE_MAX_ATTEMPTS=3
ALERT_DRAIN_MAX=6
ALERT_QUEUE_MAX_PRICE_AGE_SEC=90

# Watchlist kandidat near-miss
WATCH_TTL_SEC=3600
WATCH_INTERVAL_SEC=120
WATCH_MAX_PER_ROUND=4
WATCH_MAX_CHECKS=15
WATCH_TOP10_MARGIN_PCT=10
WATCH_LP_MIN_PCT=90
WATCH_BUYERS_RATIO=0.6

# Filter utama (Robinhood Chain lebih lambat matang daripada Solana)
MAX_AGE_SEC=3600
MIN_AGE_SEC=0
MIN_LIQ_USD=5000
MIN_MC_USD=8000
MAX_MC_USD=100000
TOP10_MAX_PCT=30
MIN_TOP10_HOLDERS=10
MIN_TOP10_TOTAL_PCT=5
MIN_UNIQUE_BUYERS=30
BUYER_WINDOW_SEC=300

# Keamanan kontrak EVM (GoPlus)
REQUIRE_VERIFIED_CONTRACT=true
REJECT_HONEYPOT=true
REJECT_MINTABLE=true
REJECT_HIDDEN_OWNER=true
REJECT_BLACKLIST=true
REJECT_PAUSABLE=true
REJECT_MUTABLE_TAX=true
MAX_OWNER_PCT=10
MAX_CREATOR_PCT=10
MAX_TAX_PCT=5

# LP: status dari GoPlus / cek burn on-chain untuk pool v2.
# LP_REQUIRE_KNOWN=true akan menolak pool yang posisi LP-nya belum terindeks
# (praktis menolak hampir semua pool Uniswap v4 baru).
LP_MIN_LOCKED_PCT=99
LP_ACCEPT_LOCKED=true
LP_REQUIRE_KNOWN=false
MIN_POOL_LIQ_USD=1000

# Sumber data & laju
CHAIN_ID=4663
GECKO_NETWORK=robinhood
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_FALLBACKS=https://robinhood-rpc.publicnode.com,https://robinhood.drpc.org
SCAN_PAGES=2
GECKO_MIN_INTERVAL=4
GOPLUS_MIN_INTERVAL=1.5
RPC_MIN_INTERVAL=0.1
HTTP_TIMEOUT=25
RPC_TIMEOUT=20
HTTP_RETRIES=3
SECURITY_CACHE_SEC=120
HOLDER_CACHE_SEC=120

# Holder scan on-chain
HOLDER_SCAN_CHUNK_BLOCKS=10000000
HOLDER_SCAN_MAX_CHUNKS=3
HOLDER_SCAN_MAX_LOGS=60000

# Pengukuran hasil (detik): +5m, +30m, +1j, +6j
OUTCOME_HORIZONS=300,1800,3600,21600
WIN_MFE_MIN=1.5
TRACK_MAX_ALERTS=25
TRACK_LOOKBACK_DAYS=7
TRACK_MAX_ATTEMPTS=3
REPORT_HOURS=24

# Operasional
SCAN_INTERVAL_SEC=120
LOG_KEEP_DAYS=14
